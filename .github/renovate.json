{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "security:gomodIndirectSecurityUpdates"
  ],
  "baseBranchPatterns": [
    "$default",
    "/^release-[0-9]+\\.[0-9]+$/"
  ],
  "osvVulnerabilityAlerts": true,
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchBaseBranches": [
        "/^release-[0-9]+\\.[0-9]+$/"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest",
        "lockFileMaintenance",
        "rollback",
        "replacement"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "go.etcd.io/etcd/**"
      ],
      "groupName": "etcd monorepo"
    }
  ]
}
